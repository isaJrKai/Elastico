generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String?
  displayName   String?
  avatarUrl     String?
  phone         String?
  role          String   @default("user") // user, pro, admin
  plan          String   @default("free") // free, pro, elite
  isActive      Boolean  @default(true)
  isBanned      Boolean  @default(false)
  banReason     String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret   String?
  whatsappLink  String?
  telegramLink  String?
  bio           String?
  location      String?
  timezone      String   @default("UTC")
  locale        String   @default("en")
  provider      String?  // google, email, sms
  providerId    String?
  predictionAccuracy Float @default(0)
  predictionStreak  Int  @default(0)
  bestStreak    Int     @default(0)
  totalPredictions Int  @default(0)
  correctPredictions Int @default(0)
  freeMatchesUsed   Int @default(0)
  achievements  String  @default("[]") // JSON array
  favoriteTeams String  @default("[]") // JSON array
  pinnedWidgets String  @default("[]") // JSON array
  notificationPrefs String @default("{}") // JSON
  lastLoginAt   DateTime?
  loginCount    Int      @default(0)
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  sessionId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predictions   Prediction[]
  votes         Vote[]
  bookmarks     Bookmark[]
  activities    Activity[]
  sessions      Session[]
  notifications  Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== USER-GENERATED CONTENT ====================
// (Predictions, Votes, Bookmarks reference matches by a string matchId,
//  not a DB foreign key — match data comes live from ESPN)

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String   // ESPN match ID or custom ID (no FK to Match table)
  homeTeam  String   // denormalized: home team name for display
  awayTeam  String   // denormalized: away team name for display
  competition String @default("")
  predictedHomeGoals Int
  predictedAwayGoals Int
  predictedOutcome   String // home, draw, away
  confidence    Float
  model         String   @default("elo") // elo, poisson, dixon_coles, monte_carlo, user
  actualHomeGoals  Int?
  actualAwayGoals  Int?
  isCorrect     Boolean?
  points        Int      @default(0)
  matchDate     DateTime?
  createdAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  matchId   String   // ESPN match ID (no FK)
  homeTeam  String
  awayTeam  String
  choice    String   // home, draw, away
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  matchId   String   // ESPN match ID (no FK)
  homeTeam  String
  awayTeam  String
  note      String?
  competition String @default("")
  matchDate DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

// ==================== NOTIFICATIONS & ACTIVITY ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // goal, card, kickoff, prediction_result, system, achievement
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // login, prediction, vote, bookmark, achievement, subscription_change
  metadata  String?  // JSON
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ==================== ADMIN & SYSTEM ====================

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string") // string, number, boolean, json
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("info") // info, warning, success, maintenance
  isActive  Boolean  @default(true)
  targetRole String @default("all") // all, user, pro, elite, admin
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model FeatureFlag {
  id        String   @id @default(cuid())
  name      String   @unique
  isEnabled Boolean  @default(false)
  description String?
  rollout   Float    @default(100) // percentage 0-100
  targetRoles String @default("[]") // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
