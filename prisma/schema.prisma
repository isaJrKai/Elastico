generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String?
  displayName   String?
  avatarUrl     String?
  phone         String?
  role          String   @default("user") // user, pro, admin
  plan          String   @default("free") // free, pro, elite
  isActive      Boolean  @default(true)
  isBanned      Boolean  @default(false)
  banReason     String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret   String?
  whatsappLink  String?
  telegramLink  String?
  bio           String?
  location      String?
  timezone      String   @default("UTC")
  locale        String   @default("en")
  provider      String?  // google, email, sms
  providerId    String?
  predictionAccuracy Float @default(0)
  predictionStreak  Int  @default(0)
  bestStreak    Int     @default(0)
  totalPredictions Int  @default(0)
  correctPredictions Int @default(0)
  freeMatchesUsed   Int @default(0)
  achievements  String  @default("[]") // JSON array
  favoriteTeams String  @default("[]") // JSON array
  pinnedWidgets String  @default("[]") // JSON array
  notificationPrefs String @default("{}") // JSON
  lastLoginAt   DateTime?
  loginCount    Int      @default(0)
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  sessionId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predictions   Prediction[]
  votes         Vote[]
  bookmarks     Bookmark[]
  activities    Activity[]
  sessions      Session[]
  notifications  Notification[]
  preferences   UserPreference?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== USER-GENERATED CONTENT ====================
// (Predictions, Votes, Bookmarks reference matches by a string matchId,
//  not a DB foreign key — match data comes live from ESPN)

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String   // ESPN match ID or custom ID (no FK to Match table)
  homeTeam  String   // denormalized: home team name for display
  awayTeam  String   // denormalized: away team name for display
  competition String @default("")
  predictedHomeGoals Int
  predictedAwayGoals Int
  predictedOutcome   String // home, draw, away
  confidence    Float
  model         String   @default("elo") // elo, poisson, dixon_coles, monte_carlo, user
  actualHomeGoals  Int?
  actualAwayGoals  Int?
  isCorrect     Boolean?
  points        Int      @default(0)
  matchDate     DateTime?
  createdAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  matchId   String   // ESPN match ID (no FK)
  homeTeam  String
  awayTeam  String
  choice    String   // home, draw, away
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  matchId   String   // ESPN match ID (no FK)
  homeTeam  String
  awayTeam  String
  note      String?
  competition String @default("")
  matchDate DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

// ==================== NOTIFICATIONS & ACTIVITY ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // goal, card, kickoff, prediction_result, system, achievement
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // login, prediction, vote, bookmark, achievement, subscription_change
  metadata  String?  // JSON
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ==================== ADMIN & SYSTEM ====================

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string") // string, number, boolean, json
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("info") // info, warning, success, maintenance
  isActive  Boolean  @default(true)
  targetRole String @default("all") // all, user, pro, elite, admin
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model FeatureFlag {
  id        String   @id @default(cuid())
  name      String   @unique
  isEnabled Boolean  @default(false)
  description String?
  rollout   Float    @default(100) // percentage 0-100
  targetRoles String @default("[]") // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== USER PREFERENCES (Phase 2 foundation) ====================

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteTeams   String   @default("[]")
  favoriteLeagues String   @default("[\"PL\",\"UCL\"]")
  defaultLeague   String   @default("PL")
  widgetLayout    String?
  alertRules      String   @default("[]")
  theme           String   @default("dark")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== CANONICAL ENTITY MODEL (Cycle 4) ====================
// A CanonicalTeam is the single ELASTICO identity for a real-world team.
// Multiple source-specific Team rows (espn, api-sports, football-data, understat)
// map to one CanonicalTeam via SourceIdentity.
// This prevents duplicate team entities and enables cross-source analytics.

model CanonicalTeam {
  id            String   @id @default(cuid())
  displayName   String   // ELASTICO display name (e.g. "Arsenal")
  shortCode     String?  // 3-letter code (e.g. "ARS")
  leagueCode    String?  // Primary league (e.g. "PL")
  country       String?
  logo          String?  // Best available logo across sources
  primaryColor  String   @default("#00e676")
  secondaryColor String  @default("#ffffff")
  eloRating     Float    @default(1500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // One canonical team has many source identities
  identities    SourceIdentity[]
  // Analytics reference the canonical team
  analytics     TeamAnalytic[]

  @@unique([displayName, leagueCode])
  @@index([leagueCode])
  @@index([shortCode])
}

model SourceIdentity {
  id              String   @id @default(cuid())
  canonicalTeamId String
  canonicalTeam   CanonicalTeam @relation(fields: [canonicalTeamId], references: [id], onDelete: Cascade)
  source          String   // 'espn', 'api-sports', 'football-data.org', 'understat'
  externalId      String   // The source's own team ID
  externalName    String   // The name as the source knows it
  leagueCode      String?  // League code in this source's system
  confidence      String   @default("EXACT") // EXACT, ALIAS, NORMALIZED, UNRESOLVED
  resolutionMethod String? // How it was matched (e.g. 'alias: "Brighton" -> "Brighton and Hove Albion"')
  isActive        Boolean  @default(true) // false if source deprecated this identity
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([source, externalId])
  @@index([canonicalTeamId])
  @@index([source])
  @@index([externalName])
}

// ==================== SHARED DATA WAREHOUSE ====================
// (Populated by /api/cron/sync worker from ESPN / API-Sports)

// ==================== ANALYTICAL DATA (Cycle 4) ====================
// Separate from Team identity to allow multiple sources per analytical
// metric without creating duplicate team entities.
// Each row = one source's analytical stats for one team in one season.

model TeamAnalytic {
  id              String   @id @default(cuid())
  canonicalTeamId String?
  teamId          String?
  canonicalTeam   CanonicalTeam?  @relation(fields: [canonicalTeamId], references: [id], onDelete: Cascade)
  team            Team?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  source          String   // 'understat', 'the-sports-db', etc.
  season          String   // '2024', '2024-2025', etc.
  leagueCode      String?  // 'PL', 'LIGA', etc.
  // --- Data truth classification ---
  truthClass      String   @default("UNKNOWN") // REAL, DERIVED, PROXY, MISSING, STALE, UNAVAILABLE, DEMO, DEAD
  // --- Understat fields (null = unavailable, NOT estimated) ---
  xgPerGame      Float?
  xgaPerGame     Float?
  npxGPerGame    Float?
  npxgaPerGame   Float?
  ppda            Float?   // passes per defensive action
  ppdaAllowed     Float?
  deep            Float?   // deep completions per game
  deepAllowed     Float?
  // --- Source identity (for debugging entity resolution) ---
  sourceTeamId    String?  // Understat's own team ID
  sourceTeamName  String?  // Understat's team name (for alias debugging)
  // --- Provenance ---
  dataFreshness  String?  // 'FRESH' (< 24h), 'CURRENT' (< 7d), 'SEASON' (< 90d), 'STALE' (> 90d)
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([teamId, source, season, leagueCode])
  @@unique([canonicalTeamId, source, season, leagueCode])
  @@index([teamId])
  @@index([canonicalTeamId])
  @@index([source, leagueCode, season])
  @@index([truthClass])
}

model Team {
  id            String   @id @default(cuid())
  externalId    String?
  name          String
  code          String?
  logo          String?
  primaryColor  String   @default("#00e676")
  secondaryColor String  @default("#ffffff")
  country       String?
  league        String?
  leagueCode    String?
  founded       Int?
  venueName     String?
  venueCapacity Int?
  eloRating     Float    @default(1500)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  source        String   @default("unknown")
  sourceId      String?
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  players     Player[]
  analytics    TeamAnalytic[]

  @@unique([source, sourceId])
  @@index([name])
  @@index([leagueCode])
}

model Player {
  id            String   @id @default(cuid())
  externalId    String?
  name          String
  firstName     String?
  lastName      String?
  position      String?
  age           Int?
  nationality   String?
  photo         String?
  teamId        String
  number        Int?
  season        String?
  appearances   Int      @default(0)
  minutesPlayed Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  rating        Float?
  source        String   @default("unknown")
  sourceId      String?
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([teamId])
  @@index([goals])
}

model Match {
  id              String   @id @default(cuid())
  externalId      String?
  homeTeamId      String
  awayTeamId      String
  homeTeam        Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  competition     String   @default("")
  competitionCode String?
  season          String?
  round           String?
  date            DateTime?
  status          String   @default("upcoming")
  minute          Int?
  venue           String?
  homeScore       Int      @default(0)
  awayScore       Int      @default(0)
  halfTimeHome   Int?
  halfTimeAway   Int?
  homeXg          Float?
  awayXg          Float?
  homeXgSource    String?  // 'understat', 'api-sports', 'proxy:shots_on_target*0.1', null=unavailable
  awayXgSource    String?
  homeXgTruthClass String?  // REAL, DERIVED, PROXY, MISSING
  awayXgTruthClass String?
  possessionHome Float?
  possessionAway Float?
  shotsHome      Int?
  shotsAway      Int?
  shotsOnTargetHome Int?
  shotsOnTargetAway Int?
  cornersHome    Int?
  cornersAway    Int?
  source          String   @default("unknown")
  sourceId        String?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events      MatchEvent[]

  @@unique([source, sourceId])
  @@index([status])
  @@index([date])
  @@index([competitionCode])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model MatchEvent {
  id          String   @id @default(cuid())
  matchId     String
  externalId  String?
  minute      Int
  type        String
  detail       String?
  team         String?
  playerId    String?
  playerName  String
  playerPhoto  String?
  assistName  String?
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([type])
}

model StandingEntry {
  id            String   @id @default(cuid())
  teamId        String?
  teamName      String
  teamCode      String?
  teamLogo      String?
  competition   String
  competitionCode String?
  season        String?
  rank          Int
  played        Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  goalDiff      Int      @default(0)
  points        Int      @default(0)
  form          String?
  homeRecord    String?
  source        String   @default("unknown")
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([competitionCode, season, teamName])
  @@index([competitionCode])
  @@index([rank])
}

model SyncLog {
  id            String   @id @default(cuid())
  source        String
  action        String
  status        String
  recordsProcessed Int @default(0)
  recordsCreated   Int @default(0)
  recordsUpdated   Int @default(0)
  errorMessage  String?
  durationMs    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

// ==================== ODDS DATA WAREHOUSE ====================
// TheOdds API doesn't provide historical data, so we persist
// every snapshot we get. This builds a historical record over time.
// Flow: API Key -> cron/route fetches odds -> saved here -> app reads from here

model OddsSnapshot {
  id            String   @id @default(cuid())
  externalId    String   // TheOdds API event ID
  source        String   @default("the-odds-api") // 'the-odds-api', 'api-sports', 'football-data.org'
  sportKey      String   // 'soccer_epl', 'soccer_la_liga', etc.
  homeTeam      String
  awayTeam      String
  commenceTime  DateTime?
  // Match Winner (1X2)
  homeWinOdds   Float?
  drawOdds      Float?
  awayWinOdds   Float?
  bookmaker     String?
  // Spreads (Asian Handicap)
  homeSpreadOdds Float?
  awaySpreadOdds Float?
  spreadLine    String?   // e.g. "-0.5", "+1.5"
  // Totals (Over/Under)
  overOdds      Float?
  underOdds     Float?
  totalLine     String?   // e.g. "2.5"
  // Raw JSON backup for any data we don't parse yet
  rawData       String?   // JSON blob of the full bookmaker data
  // Provenance
  fetchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([externalId, source, fetchedAt])
  @@index([sportKey])
  @@index([homeTeam])
  @@index([awayTeam])
  @@index([commenceTime])
  @@index([source, fetchedAt])
}

// ==================== NEWS CACHE ====================
// News articles cached from Newsdata.io.
// Flow: API Key -> cron/route fetches news -> saved here -> app reads from here

model NewsArticle {
  id            String   @id @default(cuid())
  externalId    String   @unique // Newsdata.io article_id
  title         String
  summary       String?  // description field (first 200 chars)
  content       String?  // full content
  sourceName    String
  sourceUrl     String
  category      String   @default("sports")
  imageUrl      String?
  country       String?
  language      String   @default("en")
  sentiment     String?  // positive, negative, neutral
  isBreaking    Boolean  @default(false)
  publishedAt   DateTime?
  fetchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
  @@index([fetchedAt])
  @@index([sourceName])
}
