# ── ELASTICO Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env to GitHub!

# ── REQUIRED ────────────────────────────────────────────────────────────
# Secret for signing JWT tokens (any long random string works)
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Database (SQLite — works out of the box, no setup needed)
DATABASE_URL=file:./dev.db

# ── OPTIONAL — AI Features ──────────────────────────────────────────────
# Get your key at: https://build.nvidia.com/
# Without this, ELASTICO uses its built-in offline analysis engine
NVIDIA_API_KEY=

# ── OPTIONAL — Discord Alerts ──────────────────────────────────────────
# Create a webhook in your Discord server:
#   Server Settings → Integrations → Webhooks → New Webhook → Copy URL
# Alerts for: security violations, self-audit failures, system errors
DISCORD_WEBHOOK_URL=

# ── OPTIONAL — Public URL (for Discord gateway callbacks) ──────────────
# Set this to your deployed URL (e.g. https://elastico.yourdomain.com)
NEXT_PUBLIC_BASE_URL=http://localhost:3000