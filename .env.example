# ── ELASTICO Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── REQUIRED ────────────────────────────────────────────────────────────
# Secret for signing JWT tokens (any long random string works)
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# ── DATABASE (Neon Postgres) ───────────────────────────────────────────
DATABASE_URL=postgresql://elastico_user:xxx@ep-xxx.us-east-2.aws.neon.tech/elastico_db?sslmode=require
DIRECT_URL=postgresql://elastico_user:xxx@ep-xxx.us-east-2.aws.neon.tech/elastico_db?sslmode=require

# ── DATA APIS ──────────────────────────────────────────────────────────
# API-Sports: Fixtures, odds, predictions, standings, H2H, injuries (100 req/day free)
# Get key at: https://api-sports.io/
API_SPORTS_KEY=

# TheOdds API: Real bookmaker odds, spreads, totals (500 req/month free)
# Get key at: https://the-odds-api.com/
THE_ODDS_API_KEY=

# Football-Data.org: Standings, matches, basic odds (10 req/min free)
# Get key at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Newsdata.io: Real football news from thousands of sources (200 req/day free)
# Get key at: https://newsdata.io/
NEWSDATA_API_KEY=

# TheSportsDB: Team badges, player info, league tables, past results (free with patron key)
# Get key at: https://www.thesportsdb.com/api.php (patron key = 123)
THE_SPORTS_DB_KEY=123

# ── OPTIONAL — AI Features ──────────────────────────────────────────────
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# ── OPTIONAL — Discord Alerts ──────────────────────────────────────────
# Discord Server → Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ── OPTIONAL — Public URL ──────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://elastico.vercel.app